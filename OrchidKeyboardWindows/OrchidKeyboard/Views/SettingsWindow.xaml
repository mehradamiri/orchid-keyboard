<Window x:Class="OrchidKeyboard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrchidKeyboard.Views"
        Title="Orchid Keyboard Settings"
        Width="860" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="24,20,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Orchid Keyboard"
                               FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Configure your key mappings"
                               FontSize="11" Foreground="Gray" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E8E8E8"
                        CornerRadius="6" Padding="10,4">
                    <TextBlock x:Name="ProfileNameText"
                               FontSize="12" Foreground="Gray" />
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Height="1" Background="#D0D0D0" />

        <!-- Toolbar (bottom) -->
        <Border DockPanel.Dock="Bottom" Height="1" Background="#D0D0D0" />
        <Border DockPanel.Dock="Bottom" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="MappedCountText" Grid.Column="0"
                           FontSize="11" Foreground="Gray"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="LaunchAtLoginCheck" Content="Launch at login"
                              VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                              Checked="OnLaunchAtLoginChanged" Unchecked="OnLaunchAtLoginChanged" />
                    <CheckBox x:Name="HideTrayCheck" Content="Hide tray icon"
                              VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"
                              Checked="OnHideTrayChanged" Unchecked="OnHideTrayChanged" />
                    <Button Content="Clear All Mappings" Padding="8,4" Margin="0,0,8,0"
                            FontSize="11" Click="OnClearAll" />
                    <Button Content="Setup Wizard" Padding="8,4" Margin="0,0,8,0"
                            FontSize="11" Click="OnOpenWizard" />
                    <Button Content="&#x2615; Donate" Padding="8,4"
                            FontSize="11" Click="OnDonate" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Keyboard area -->
        <Border Padding="24,20">
            <local:KeyboardControl x:Name="KeyboardDisplay"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
        </Border>
    </DockPanel>
</Window>
