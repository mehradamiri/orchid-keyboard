<Window x:Class="OrchidKeyboard.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Up Your Keyboard"
        Width="620" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <DockPanel>
        <!-- Progress bar -->
        <Border DockPanel.Dock="Top" Padding="24,12">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="StepLabel"
                               FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Left" />
                    <TextBlock x:Name="RowLabel"
                               FontSize="11" Foreground="Gray" FontWeight="Medium"
                               HorizontalAlignment="Right" />
                </Grid>
                <Grid Height="6" Margin="0,4,0,0">
                    <Border Background="#D0D0D0" CornerRadius="3" />
                    <Border x:Name="ProgressFill"
                            Background="#6C5CE7" CornerRadius="3"
                            HorizontalAlignment="Left" />
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="1" Background="#D0D0D0" />

        <!-- Navigation bar (bottom) -->
        <Border DockPanel.Dock="Bottom" Height="1" Background="#D0D0D0" />
        <Border DockPanel.Dock="Bottom" Padding="24,12">
            <Grid>
                <Button x:Name="BackButton" Content="Back"
                        HorizontalAlignment="Left"
                        Padding="16,8" FontSize="13"
                        Click="OnBack" />
                <Button x:Name="NextButton" Content="Next"
                        HorizontalAlignment="Right"
                        Padding="16,8" FontSize="13"
                        Click="OnNext" IsDefault="True" />
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid x:Name="ContentArea" />
    </DockPanel>
</Window>
