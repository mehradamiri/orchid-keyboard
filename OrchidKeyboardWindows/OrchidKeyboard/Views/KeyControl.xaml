<UserControl x:Class="OrchidKeyboard.Views.KeyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
             MouseLeftButtonDown="OnClick"
             Cursor="Hand">
    <Border x:Name="KeyBorder"
            CornerRadius="7"
            BorderThickness="2"
            BorderBrush="Transparent"
            SnapsToDevicePixels="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="KeyScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="KeyShadow" Color="Black" Opacity="0.05"
                               BlurRadius="4" ShadowDepth="1" Direction="270" />
        </Border.Effect>
        <Grid>
            <!-- Modifier key label -->
            <TextBlock x:Name="ModifierLabel"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="10" FontWeight="Medium"
                       Foreground="#888888"
                       Visibility="Collapsed" />

            <!-- Normal key content -->
            <StackPanel x:Name="KeyContent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Visible">
                <TextBlock x:Name="SourceLabel"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#888888" />
                <TextBlock x:Name="TargetLabel"
                           HorizontalAlignment="Center"
                           FontSize="16" FontWeight="Medium"
                           Margin="0,1,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
